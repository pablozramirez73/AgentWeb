@inject NavigationManager Nav
@implements IDisposable

<script type="module" src="_content/AgentWeb.Shared/Layout/NavMenu.razor.js"></script>

<div class="brand-row">
    <a class="brand" href="">
        <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="6" cy="12" r="3" /><circle cx="18" cy="6" r="3" /><circle cx="18" cy="18" r="3" />
            <path d="M8.6 10.6 15.4 7.4M8.6 13.4l6.8 3.2" />
        </svg>
        <span>AgentWeb</span>
    </a>
    <input type="checkbox" title="Menu" class="navbar-toggler" aria-label="Apri il menu" />
</div>

<div id="nav-scrollable" class="nav-scrollable">
    <nav class="nav-list" aria-label="Sezioni">
        <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18" /></svg>
            Canali
        </NavLink>
        <NavLink class="nav-item" href="activity">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4" /></svg>
            Attività
        </NavLink>
        <NavLink class="nav-item" href="debate">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.7A8 8 0 1 1 21 12Z" /><path d="M8.5 11h.01M12 11h.01M15.5 11h.01" /></svg>
            Dibattito
        </NavLink>
        @* Una sola voce per tutte le sezioni delle impostazioni (account, sicurezza, agenti). *@
        <a class="nav-item @(InSettings ? "active" : "")" href="account" aria-current="@(InSettings ? "page" : null)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z" /></svg>
            Impostazioni
        </a>
    </nav>
    <p class="nav-foot">Persone e agenti, nello stesso spazio.</p>
</div>

@code {
    static readonly string[] SettingsPages = ["account", "appearance", "notifications", "devices", "settings"];
    // Nell'app (tutto interattivo) il menu non si ridisegna da solo cambiando pagina.
    protected override void OnInitialized() => Nav.LocationChanged += Redraw;
    void Redraw(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() => Nav.LocationChanged -= Redraw;

    bool InSettings => SettingsPages.Contains(Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/'));
}
