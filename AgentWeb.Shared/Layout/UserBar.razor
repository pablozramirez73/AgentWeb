@rendermode InteractiveServer
@inject IUserSession Session

@if (Session.UserName is { } user)
{
    <div class="userbar">
        <span class="avatar" style="--size: 1.85rem" aria-hidden="true">@Initials(user)</span>
        <span class="userbar-name">@user</span>
        <button class="btn btn-link btn-sm" @onclick="Session.LogoutAsync" title="Esci">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 17l5-5-5-5M15 12H3" /></svg>
            Esci
        </button>
    </div>
}

@code {
    protected override Task OnInitializedAsync() => Session.InitializeAsync();

    static string Initials(string user)
    {
        var name = user.Split('@')[0];
        var parts = name.Split(['.', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}" : name[..Math.Min(2, name.Length)];
    }
}
