@inherits LayoutComponentBase

<div class="shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <div class="main">
        <header class="topbar">
            <UserBar />
        </header>

        <main class="content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @T("app.error")
    <a href="." class="reload">@T("app.reload")</a>
    <span class="dismiss" aria-label="@T("app.close")">✕</span>
</div>
