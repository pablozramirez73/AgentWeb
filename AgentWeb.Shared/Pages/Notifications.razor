@page "/notifications"
@rendermode InteractiveServer
@inject IAccountClient Accounts
@inject AgentWeb.Shared.Services.IDevicePush Device

<PageTitle>@T("settings.notifications") · AgentWeb</PageTitle>

<SettingsShell Title="@T("settings.notifications")">
    @if (notice is { } n) { <div class="alert @(n.Ok ? "alert-success" : "alert-danger") py-2" role="status">@n.Text</div> }

    <h3 class="section-label">@T("notif.thisDevice")</h3>
    <div class="card-block card-row">
        <div>
            <h4>@T("notif.push")</h4>
            <p class="text-muted mb-0">@Status</p>
        </div>
        @if (available && device is null) { <button class="btn btn-primary" data-push-enable disabled="@busy" @onclick="EnableAsync">@T("common.enable")</button> }
        else if (device is not null)
        {
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary" disabled="@busy" @onclick="TestAsync">@T("notif.sendTest")</button>
                <button class="btn btn-outline-danger" disabled="@busy" @onclick="DisableAsync">@T("common.disable")</button>
            </div>
        }
    </div>

    <h3 class="section-label">@T("notif.alertWhen")</h3>
    <div class="card-block d-flex flex-column gap-3">
        @if (settings is null) { <p class="text-muted m-0">@T("common.loading")</p> }
        else
        {
            <Toggle Label="@T("notif.mentions")" Hint="@T("notif.mentions.hint")" Value="settings.Mentions" Changed="v => SaveAsync(settings with { Mentions = v })" />
            <Toggle Label="@T("notif.private")" Hint="@T("notif.private.hint")" Value="settings.Private" Changed="v => SaveAsync(settings with { Private = v })" />
            <Toggle Label="@T("notif.tasks")" Hint="@T("notif.tasks.hint")" Value="settings.Tasks" Changed="v => SaveAsync(settings with { Tasks = v })" />
        }
    </div>
    <p class="text-muted small">@T("notif.footer")</p>
</SettingsShell>

@code {
    NotificationSettingsDto? settings;
    PushConfigDto? config;
    PushDeviceRequest? device;
    bool available, checkedDevice, busy;
    (bool Ok, string Text)? notice;

    string Status => T(!checkedDevice ? "notif.checking"
        : device is not null ? "notif.on"
        : available ? "notif.off"
        : Device.Kind == "web" ? "notif.browserUnsupported"
        : config?.Kinds.Contains(Device.Kind) == true ? "notif.appUnsupported"
        : "notif.serverOff");

    protected override async Task OnInitializedAsync()
    {
        try { settings = await Accounts.GetNotificationSettingsAsync(); config = await Accounts.GetPushConfigAsync(); }
        catch (Exception ex) { notice = (false, ex.GetBaseException().Message); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            available = config is not null && config.Kinds.Contains(Device.Kind) && await Device.SupportedAsync();
            if (available && await Device.CurrentAsync() is { } d)
            {
                await Accounts.RegisterPushDeviceAsync(d); // il server potrebbe averlo dimenticato (sessione revocata): si riallinea
                device = d;
            }
        }
        catch (Exception ex) { notice = (false, ex.GetBaseException().Message); }
        checkedDevice = true;
        StateHasChanged();
    }

    Task EnableAsync() => Act(async () =>
    {
        var d = await Device.SubscribeAsync(config!);
        if (d is null) { notice = (false, T("notif.denied")); return; }
        await Accounts.RegisterPushDeviceAsync(d);
        device = d;
        notice = (true, T("notif.enabled"));
    });

    Task DisableAsync() => Act(async () =>
    {
        var token = device!.Token;
        await Device.UnsubscribeAsync();
        await Accounts.UnregisterPushDeviceAsync(token);
        device = null;
        notice = (true, T("notif.disabled"));
    });

    Task TestAsync() => Act(async () =>
    {
        var n = await Accounts.SendTestPushAsync();
        notice = n > 0 ? (true, T(n == 1 ? "notif.testSentOne" : "notif.testSent", n)) : (false, T("notif.testRejected"));
    });

    Task SaveAsync(NotificationSettingsDto s) => Act(async () => { await Accounts.SaveNotificationSettingsAsync(s); settings = s; });

    async Task Act(Func<Task> action)
    {
        busy = true; notice = null;
        try { await action(); }
        catch (Exception ex) { notice = (false, ex.GetBaseException().Message); }
        busy = false;
    }
}
