@page "/stats"
@rendermode InteractiveWebAssembly
@inject IWorkspaceClient Ws

<PageTitle>@T("nav.stats") · AgentWeb</PageTitle>

@* Token, lavori degli agenti, errori e messaggi degli ultimi giorni, solo dei canali che vedi. *@
<div class="stats-page">
    <header class="stats-head">
        <h2>@T("nav.stats")</h2>
        <StatsTabs />
        <div class="seg" role="group" aria-label="@T("stats.period")">
            @foreach (var d in Periods)
            {
                <button class="@(days == d ? "on" : "")" @onclick="() => LoadAsync(d)">@T("stats.days", d)</button>
            }
        </div>
    </header>

    @if (error is not null) { <div class="alert alert-danger py-2" role="alert">@error</div> }
    @if (stats is null) { <p class="text-muted">@T("common.loading")</p> }
    else
    {
        var input = stats.Daily.Sum(d => d.InputTokens);
        var output = stats.Daily.Sum(d => d.OutputTokens);
        var runs = stats.Daily.Sum(d => d.Runs);
        var errors = stats.Daily.Sum(d => d.Errors);

        <section class="tiles">
            <div class="tile"><span class="tile-label">@T("stats.totalTokens")</span><strong>@Num(input + output)</strong><span class="tile-sub">@Num(input) in · @Num(output) out</span></div>
            <div class="tile"><span class="tile-label">@T("stats.agentRuns")</span><strong>@Num(runs)</strong><span class="tile-sub">@(runs == 0 ? "—" : T("stats.tokensPerRun", Num((input + output) / runs)))</span></div>
            <div class="tile"><span class="tile-label">@T("stats.errors")</span><strong>@Num(errors)</strong><span class="tile-sub">@(runs == 0 ? "—" : T("stats.ofRuns", (100.0 * errors / runs).ToString("0.#")))</span></div>
            <div class="tile"><span class="tile-label">@T("nav.messages")</span><strong>@Num(stats.Daily.Sum(d => d.Messages))</strong><span class="tile-sub">@T("stats.peopleAndAgents")</span></div>
        </section>

        @if (selected is { } s)
        {
            <p class="day-detail" aria-live="polite">
                <strong>@Date(s.Day)</strong> · @T("stats.dayDetail", Num(s.InputTokens), Num(s.OutputTokens), s.Runs, s.Errors, s.Messages)
                <button class="btn btn-link btn-sm" @onclick="() => selected = null">@T("app.close")</button>
            </p>
        }

        @Chart(T("stats.tokensPerDay"), stats.Daily, d => [(d.InputTokens, "s1"), (d.OutputTokens, "s2")], [("Input", "s1"), ("Output", "s2")])
        @Chart(T("stats.runsPerDay"), stats.Daily, d => [(d.Runs - d.Errors, "s1"), (d.Errors, "bad")], [(T("stats.succeeded"), "s1"), (T("stats.failed"), "bad")])
        @Chart(T("stats.messagesPerDay"), stats.Daily, d => [(d.Messages, "s1")], [])

        <h3 class="section-label">@T("stats.perAgent")</h3>
        <div class="card-block p-0 table-wrap">
            @if (stats.Agents.Count == 0) { <p class="text-muted m-0 p-3">@T("stats.noRuns")</p> }
            else
            {
                var maxTokens = Math.Max(1, stats.Agents.Max(a => a.InputTokens + a.OutputTokens));
                <table class="table stats-table m-0">
                    <thead><tr><th>@T("field.agent")</th><th class="num">@T("stats.runs")</th><th class="num">@T("stats.errors")</th><th class="num">Token in</th><th class="num">Token out</th><th class="num">@T("stats.avgDuration")</th><th class="num">Max</th><th aria-label="@T("stats.tokenShare")"></th></tr></thead>
                    <tbody>
                        @foreach (var a in stats.Agents)
                        {
                            <tr>
                                <td>@a.Agent</td><td class="num">@a.Runs</td><td class="num @(a.Errors > 0 ? "text-danger" : "")">@a.Errors</td>
                                <td class="num">@Num(a.InputTokens)</td><td class="num">@Num(a.OutputTokens)</td>
                                <td class="num">@Secs(a.AvgSeconds)</td><td class="num">@Secs(a.MaxSeconds)</td>
                                <td class="share"><span style="width: @Pct(a.InputTokens + a.OutputTokens, maxTokens)"></span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <h3 class="section-label">@T("stats.perModel")</h3>
        <div class="card-block p-0 table-wrap">
            @if (stats.Models.Count == 0) { <p class="text-muted m-0 p-3">@T("stats.noModels")</p> }
            else
            {
                <table class="table stats-table m-0">
                    <thead><tr><th>@T("stats.model")</th><th class="num">@T("stats.runs")</th><th class="num">Token in</th><th class="num">Token out</th><th class="num">@T("stats.total")</th></tr></thead>
                    <tbody>
                        @foreach (var m in stats.Models)
                        {
                            <tr><td class="mono">@m.Model</td><td class="num">@m.Runs</td><td class="num">@Num(m.InputTokens)</td><td class="num">@Num(m.OutputTokens)</td><td class="num">@Num(m.InputTokens + m.OutputTokens)</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <h3 class="section-label">@T("stats.tasksByStatus")</h3>
        <div class="card-block">
            @{ var maxTask = Math.Max(1, stats.Tasks.Select(t => t.Count).DefaultIfEmpty().Max()); }
            @if (stats.Tasks.Count == 0) { <p class="text-muted m-0">@T("stats.noTasks")</p> }
            @foreach (var t in stats.Tasks)
            {
                <div class="hbar"><span class="hbar-label">@Status(t.Status)</span><span class="hbar-track"><span class="@(t.Status == WorkStatus.Failed ? "bad" : "s1")" style="width: @Pct(t.Count, maxTask)"></span></span><span class="hbar-value">@t.Count</span></div>
            }
        </div>

        <h3 class="section-label">@T("stats.latestErrors")</h3>
        <div class="card-block p-0">
            @if (stats.Errors.Count == 0) { <p class="text-muted m-0 p-3">@T("stats.noErrors")</p> }
            @foreach (var e in stats.Errors)
            {
                <div class="err-row">
                    <div class="err-meta"><span class="err-icon" aria-hidden="true">⚠</span> <strong>@e.Agent</strong> · #@e.Channel · @e.Kind · @e.StartedAt.ToLocalTime().ToString("dd/MM HH:mm") · @Secs(e.Seconds ?? 0)</div>
                    <div class="err-text">@e.Error</div>
                </div>
            }
        </div>
    }
</div>

@code {
    static readonly int[] Periods = [7, 30, 90];
    int days = 30;
    StatsDto? stats;
    DayStatDto? selected;
    string? error;

    protected override Task OnInitializedAsync() => LoadAsync(days);

    async Task LoadAsync(int d)
    {
        days = d; error = null; selected = null;
        try { stats = await Ws.GetStatsAsync(d); }
        catch (Exception ex) { error = ex.GetBaseException().Message; }
    }

    // Barre impilate per giorno; toccare una colonna mostra i valori del giorno (su iPhone non c'è il passaggio del mouse).
    RenderFragment Chart(string title, List<DayStatDto> data, Func<DayStatDto, (long Value, string Css)[]> parts, (string Label, string Css)[] legend) => __builder =>
    {
        var max = Math.Max(1, data.Max(d => parts(d).Sum(p => p.Value)));
        <section class="card-block chart">
            <div class="chart-head">
                <h3 class="chart-title">@title</h3>
                @if (legend.Length > 1)
                {
                    <ul class="legend">@foreach (var (label, css) in legend) { <li><span class="swatch @css"></span>@label</li> }</ul>
                }
                <span class="chart-max">max @Num(max)</span>
            </div>
            <div class="bars" style="--n: @data.Count">
                @foreach (var d in data)
                {
                    var p = parts(d);
                    <button class="col @(selected == d ? "sel" : "")" title="@($"{Date(d.Day)}: {string.Join(" · ", p.Zip(legend.Length > 0 ? legend.Select(l => l.Label) : [T("stats.total")]).Select(x => $"{x.Second} {Num(x.First.Value)}"))}")"
                            aria-label="@Date(d.Day)" @onclick="() => selected = selected == d ? null : d">
                        @foreach (var (value, css) in p.Where(x => x.Value > 0))
                        {
                            <span class="seg-bar @css" style="height: @Pct(value, max)"></span>
                        }
                    </button>
                }
            </div>
            <div class="axis"><span>@Date(data[0].Day)</span><span>@Date(data[^1].Day)</span></div>
        </section>
    };

    static string Pct(long v, long max) => (100.0 * v / max).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
    static string Num(long n) => n >= 1_000_000 ? $"{n / 1_000_000.0:0.#} M" : n >= 10_000 ? $"{n / 1000.0:0.#} k" : n.ToString("N0");
    static string Secs(double s) => s >= 60 ? $"{s / 60:0.#} min" : $"{s:0.#} s";
    static string Date(DateOnly d) => $"{d.Day} {T("stats.months").Split(',')[d.Month - 1]}";
    static string Status(WorkStatus s) => T("stats.status." + s);
}
