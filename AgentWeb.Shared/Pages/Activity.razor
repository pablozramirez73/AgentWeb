@page "/activity"
@rendermode InteractiveWebAssembly
@implements IAsyncDisposable
@inject IWorkspaceClient Ws

<PageTitle>Attività · AgentWeb</PageTitle>

<div class="page-header">
    <h3>Attività</h3>
    <p>Cosa stanno facendo gli agenti adesso, cosa hanno appena finito e i task ancora aperti, nei canali che vedi. Si aggiorna da sola.</p>
</div>

@if (error is not null) { <div class="alert alert-danger py-2" role="alert">@error</div> }
@if (data is null)
{
    <p class="text-muted">Caricamento…</p>
}
else
{
    <h4>In corso</h4>
    @if (data.Running.Count == 0) { <p class="text-muted">Nessun agente al lavoro.</p> }
    <ul class="runs">
        @foreach (var r in data.Running)
        {
            <li class="run running">
                <span class="dot" aria-hidden="true"></span>
                <strong>@r.Agent</strong> · @r.Kind in <a href="channels/@r.ChannelId">#@r.Channel</a>
                <span class="text-muted">da @Since(r.StartedAt)</span>
            </li>
        }
    </ul>

    <h4 class="mt-4">Task aperti</h4>
    @if (data.OpenTasks.Count == 0) { <p class="text-muted">Nessun task aperto.</p> }
    <ul class="runs">
        @foreach (var t in data.OpenTasks)
        {
            <li class="run">
                <span class="badge @(t.Status == WorkStatus.InProgress ? "bg-primary" : "bg-secondary")">@(t.Status == WorkStatus.InProgress ? "in corso" : "da fare")</span>
                <a href="channels/@t.ChannelId">#@t.Id @t.Title</a>
                <span class="text-muted">@(t.Assignee is { } a ? "· " + a : "· non assegnato")</span>
            </li>
        }
    </ul>

    <h4 class="mt-4">Appena terminati</h4>
    @if (data.Recent.Count == 0) { <p class="text-muted">Ancora niente da quando il server è partito.</p> }
    <ul class="runs">
        @foreach (var r in data.Recent)
        {
            <li class="run @(r.Error is null ? "" : "failed")">
                <span>@(r.Error is null ? "✓" : "✕")</span>
                <strong>@r.Agent</strong> · @r.Kind in <a href="channels/@r.ChannelId">#@r.Channel</a>
                <span class="text-muted">@r.StartedAt.ToLocalTime().ToString("HH:mm:ss") · @(r.Seconds?.ToString("0.0")) s</span>
                @if (r.Error is { } e) { <div class="text-danger small">@e</div> }
            </li>
        }
    </ul>
}

@code {
    ActivityDto? data;
    string? error;
    readonly CancellationTokenSource stop = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (!OperatingSystem.IsBrowser() && !OperatingSystem.IsIOS() && !OperatingSystem.IsAndroid()) return; // prerender: niente timer sul server
        _ = RefreshLoopAsync();
    }

    // shortcut: aggiornamento ogni 3 secondi invece di un evento dedicato; basta per una pagina di controllo.
    async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(stop.Token))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    async Task LoadAsync()
    {
        try { data = await Ws.GetActivityAsync(); error = null; }
        catch (Exception ex) { error = ex.GetBaseException().Message; }
    }

    static string Since(DateTimeOffset t)
    {
        var s = (DateTimeOffset.UtcNow - t).TotalSeconds;
        return s < 60 ? $"{s:0} s" : $"{s / 60:0} min";
    }

    public ValueTask DisposeAsync() { stop.Cancel(); stop.Dispose(); return ValueTask.CompletedTask; }
}
