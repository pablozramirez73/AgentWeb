@page "/account"
@rendermode InteractiveServer
@inject IUserSession Session
@inject IAccountClient Accounts
@inject NavigationManager Nav

<PageTitle>Account · AgentWeb</PageTitle>

<SettingsShell Title="Account">
    @if (notice is { } n) { <div class="alert @(n.Ok ? "alert-success" : "alert-danger") py-2" role="status">@n.Text</div> }
    @if (profile is null)
    {
        <p class="text-muted">@(loadError ?? "Caricamento…")</p>
    }
    else
    {
        <div class="card-block">
            <div class="profile">
                @if (profile.Avatar is { } src) { <img class="profile-photo" src="@src" alt="Foto profilo" /> }
                else { <span class="avatar profile-avatar" style="@AvatarColor.Style(profile.UserName)" aria-hidden="true">@Initials(profile.UserName)</span> }
                <div class="profile-id">
                    <div class="profile-name">@(profile.DisplayName ?? Handle(profile.UserName))</div>
                    <div class="profile-handle">@@@Handle(profile.UserName)</div>
                    <div class="d-flex gap-2 mt-2 flex-wrap">
                        <label class="btn btn-sm btn-outline-secondary mb-0">
                            Cambia foto
                            <InputFile class="visually-hidden" accept="image/png,image/jpeg,image/webp" OnChange="UploadAsync" />
                        </label>
                        @if (profile.Avatar is not null) { <button class="btn btn-sm btn-link text-danger" @onclick="RemovePhotoAsync">Rimuovi</button> }
                    </div>
                </div>
            </div>

            <form @onsubmit="SaveAsync" class="d-flex flex-column gap-3">
                <div>
                    <label class="form-label" for="display-name">Nome visualizzato</label>
                    <input class="form-control" id="display-name" maxlength="60" @bind="displayName" @bind:event="oninput" placeholder="@Handle(profile.UserName)" />
                </div>
                <div>
                    <label class="form-label" for="username">Username</label>
                    <div class="input-group">
                        <span class="input-group-text">@@</span>
                        <input class="form-control" id="username" value="@Handle(profile.UserName)" readonly aria-describedby="username-help" />
                    </div>
                    <div class="form-text" id="username-help">Viene dall'email e serve per le @@menzioni: non si cambia.</div>
                </div>
                <div>
                    <div class="form-label">Email</div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="profile-email">@profile.UserName</span>
                        @if (profile.EmailConfirmed) { <span class="badge-verified">✓ Verificata</span> }
                        else
                        {
                            <span class="badge-unverified">Non verificata</span>
                            @if (profile.CanSendEmail) { <button type="button" class="btn btn-sm btn-link" @onclick="SendConfirmationAsync">Invia email di conferma</button> }
                        }
                    </div>
                </div>
                <div><button class="btn btn-primary" type="submit" disabled="@(!ProfileChanged)">Salva profilo</button></div>
            </form>
        </div>

        <h3 class="section-label">Account collegati</h3>
        <div class="card-block p-0">
            @if (profile.Providers.Count == 0)
            {
                <p class="text-muted m-0 p-3">Nessun accesso esterno configurato sul server. Un amministratore può attivare Google e GitHub (<code>Auth:Google:ClientId</code>, <code>Auth:GitHub:ClientId</code>).</p>
            }
            @foreach (var p in profile.Providers)
            {
                var linked = profile.Logins.FirstOrDefault(l => l.Provider == p);
                <div class="linked-row">
                    <span class="linked-icon" aria-hidden="true">@((MarkupString)Icon(p))</span>
                    <div class="linked-body">
                        <strong>@p</strong>
                        <div class="text-muted small">@(linked is null ? "Non collegato" : $"Collegato come {linked.Account ?? p}")</div>
                    </div>
                    @if (linked is not null) { <button class="btn btn-outline-secondary" @onclick="() => DisconnectAsync(p)">Scollega</button> }
                    else if (InBrowser) { <a class="btn btn-outline-secondary" href="@($"account/external/{p}?mode=link")" data-enhance-nav="false">Collega</a> }
                    else { <span class="text-muted small">Collegalo dal browser</span> }
                </div>
            }
        </div>

        <h3 class="section-label">Password</h3>
        <div class="card-block">
            <p class="text-muted">Gli altri browser e app dovranno accedere di nuovo; i token MCP restano validi.</p>
            <form @onsubmit="ChangePasswordAsync" class="d-flex flex-column gap-2" style="max-width: 420px">
                <input class="form-control" type="password" autocomplete="current-password" @bind="currentPassword" @bind:event="oninput" placeholder="Password attuale" aria-label="Password attuale" />
                <input class="form-control" type="password" autocomplete="new-password" @bind="newPassword" @bind:event="oninput" placeholder="Nuova password" aria-label="Nuova password" />
                <input class="form-control" type="password" autocomplete="new-password" @bind="confirmPassword" @bind:event="oninput" placeholder="Ripeti la nuova password" aria-label="Ripeti la nuova password" />
                <div class="form-text">Almeno 6 caratteri con maiuscola, minuscola, numero e simbolo.</div>
                <div><button class="btn btn-primary" type="submit" disabled="@(currentPassword.Length == 0 || newPassword.Length == 0)">Cambia password</button></div>
            </form>
        </div>

        <div class="card-block card-row">
            <div>
                <h4>Esci</h4>
                <p class="text-muted mb-0">Chiude la sessione di questo dispositivo. Le altre si gestiscono da <a href="devices">Sicurezza e dispositivi</a>.</p>
            </div>
            <button class="btn btn-outline-danger" @onclick="Session.LogoutAsync">Esci</button>
        </div>
    }
</SettingsShell>

@code {
    ProfileDto? profile;
    string? loadError;
    string displayName = "";
    string currentPassword = "", newPassword = "", confirmPassword = "";
    (bool Ok, string Text)? notice;

    // L'app collega i provider dal browser: il flusso OAuth vive nei cookie del server, non nel token dell'app.
    bool InBrowser => Accounts.ServerBase.ToString() == Nav.BaseUri;
    bool ProfileChanged => (displayName.Trim() is { Length: > 0 } d ? d : null) != profile?.DisplayName;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        notice = new Uri(Nav.Uri).Query switch
        {
            var q when q.Contains("email=confirmed") => (true, "Email verificata."),
            var q when q.Contains("email=invalid") => (false, "Link di conferma non valido o scaduto."),
            var q when q.Contains("login=linked") => (true, "Account collegato."),
            var q when q.Contains("login=taken") => (false, "Quell'account è già collegato a un altro utente."),
            var q when q.Contains("login=failed") => (false, "Collegamento non riuscito."),
            _ => null,
        };
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        try { profile = await Accounts.GetProfileAsync(); displayName = profile.DisplayName ?? ""; loadError = null; }
        catch (Exception ex) { loadError = ex.GetBaseException().Message; }
    }

    Task SaveAsync() => Act(() => Accounts.SaveProfileAsync(displayName), "Profilo salvato.");
    Task RemovePhotoAsync() => Act(() => Accounts.SetAvatarAsync(null, null), "Foto rimossa.");
    Task DisconnectAsync(string p) => Act(() => Accounts.RemoveLoginAsync(p), $"{p} scollegato.");
    Task SendConfirmationAsync() => Act(Accounts.SendConfirmationEmailAsync, $"Ti abbiamo scritto a {profile?.UserName}: apri il link per confermare.");

    async Task UploadAsync(InputFileChangeEventArgs e)
    {
        if (e.File.Size > 256 * 1024) { notice = (false, "La foto deve pesare al massimo 256 KB."); return; }
        using var ms = new MemoryStream();
        await e.File.OpenReadStream(256 * 1024).CopyToAsync(ms);
        await Act(() => Accounts.SetAvatarAsync(e.File.ContentType, ms.ToArray()), "Foto aggiornata.");
    }

    async Task Act(Func<Task> action, string done)
    {
        try { await action(); notice = (true, done); }
        catch (Exception ex) { notice = (false, ex.GetBaseException().Message); }
        await LoadAsync();
    }

    async Task ChangePasswordAsync()
    {
        if (newPassword != confirmPassword) { notice = (false, "Le due password nuove non coincidono."); return; }
        try
        {
            await Accounts.ChangePasswordAsync(currentPassword, newPassword);
            notice = (true, "Password cambiata. Le altre sessioni sono state chiuse.");
            currentPassword = newPassword = confirmPassword = "";
        }
        catch (Exception ex) { notice = (false, ex.GetBaseException().Message); }
    }

    static string Handle(string user) => user.Split('@')[0];

    static string Initials(string user)
    {
        var parts = Handle(user).Split(['.', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}" : Handle(user)[..Math.Min(2, Handle(user).Length)];
    }

    static string Icon(string provider) => provider switch
    {
        "Google" => """<svg viewBox="0 0 24 24"><path fill="#4285F4" d="M22.6 12.2c0-.8-.1-1.5-.2-2.2H12v4.2h5.9a5 5 0 0 1-2.2 3.3v2.7h3.6c2.1-1.9 3.3-4.8 3.3-8Z"/><path fill="#34A853" d="M12 23c3 0 5.5-1 7.3-2.7l-3.6-2.7c-1 .7-2.2 1-3.7 1-2.9 0-5.3-1.9-6.2-4.5H2.1v2.8A11 11 0 0 0 12 23Z"/><path fill="#FBBC05" d="M5.8 14.1a6.6 6.6 0 0 1 0-4.2V7.1H2.1a11 11 0 0 0 0 9.8l3.7-2.8Z"/><path fill="#EA4335" d="M12 5.4c1.6 0 3.1.6 4.2 1.7l3.2-3.2A11 11 0 0 0 2.1 7.1l3.7 2.8C6.7 7.3 9.1 5.4 12 5.4Z"/></svg>""",
        "GitHub" => """<svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 1.5a10.5 10.5 0 0 0-3.3 20.5c.5.1.7-.2.7-.5v-1.8c-2.9.6-3.5-1.4-3.5-1.4-.5-1.2-1.2-1.5-1.2-1.5-.9-.7.1-.6.1-.6 1 .1 1.6 1.1 1.6 1.1.9 1.6 2.5 1.1 3.1.9.1-.7.4-1.1.6-1.4-2.3-.3-4.8-1.2-4.8-5.2 0-1.1.4-2 1.1-2.8-.1-.3-.5-1.3.1-2.8 0 0 .9-.3 2.9 1.1a10 10 0 0 1 5.2 0c2-1.4 2.9-1.1 2.9-1.1.6 1.5.2 2.5.1 2.8.7.8 1.1 1.7 1.1 2.8 0 4-2.5 4.9-4.8 5.2.4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10.5 10.5 0 0 0 12 1.5Z"/></svg>""",
        _ => "",
    };
}
