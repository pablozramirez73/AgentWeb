@page "/appearance"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>@T("settings.appearance") · AgentWeb</PageTitle>

<SettingsShell Title="@T("settings.appearance")">
    <h3 class="section-label">@T("theme.title")</h3>
    <p class="text-muted">@T("theme.thisDevice")</p>
    <div class="themes" role="radiogroup" aria-label="@T("theme.title")">
        @foreach (var (value, label, hint) in Options)
        {
            <label class="theme-option @(theme == value ? "selected" : "")">
                <input type="radio" name="theme" value="@value" checked="@(theme == value)" @onchange="() => SetAsync(value)" />
                <span class="theme-preview theme-@value" aria-hidden="true"><span></span><span></span><span></span></span>
                <strong>@label</strong>
                <small class="text-muted">@hint</small>
            </label>
        }
    </div>
</SettingsShell>

@code {
    static (string Value, string Label, string Hint)[] Options =>
    [
        ("system", T("theme.system"), T("theme.system.hint")),
        ("light", T("theme.light"), T("theme.light.hint")),
        ("dark", T("theme.dark"), T("theme.dark.hint")),
    ];

    string? theme;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        theme = await JS.InvokeAsync<string>("agentwebTheme.get");
        StateHasChanged();
    }

    async Task SetAsync(string value)
    {
        theme = value;
        await JS.InvokeVoidAsync("agentwebTheme.set", value);
    }
}
