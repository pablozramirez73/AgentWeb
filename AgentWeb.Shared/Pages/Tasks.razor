@page "/tasks"
@rendermode InteractiveWebAssembly
@implements IDisposable
@inject IWorkspaceClient Ws

<PageTitle>Task · AgentWeb</PageTitle>

@* Tutti i task dei canali che vedi: board per stato (trascinabile) o elenco, con filtri. *@
<div class="tasks-page">
    <header class="tasks-head">
        <h2>Task</h2>
        <span class="tasks-count">@Shown.Count / @Scoped.Count()</span>
    </header>

    <div class="toolbar">
        <div class="seg" role="group" aria-label="Quali task">
            <button class="@(mine ? "on" : "")" @onclick="() => mine = true">Miei <span>@tasks.Count(IsMine)</span></button>
            <button class="@(!mine ? "on" : "")" @onclick="() => mine = false">Tutti <span>@tasks.Count</span></button>
        </div>
        <label class="search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <input type="search" placeholder="Cerca nei task" aria-label="Cerca nei task" @bind="query" @bind:event="oninput" />
        </label>
        @Filter("Canale", "#", channelFilter, channels.Where(c => c.With is null).Select(c => (c.Id.ToString(), $"#{c.Name}")))
        @Filter("Stato", "◷", statusFilter, Columns.Select(c => (c.Status.ToString(), c.Label)).Append((WorkStatus.Failed.ToString(), "Fallito")))
        @Filter("Creato da", "✎", creatorFilter, tasks.Select(t => t.CreatedBy).Distinct().Order().Select(u => (u, Name(u))))
        @Filter("Assegnato a", "@", assigneeFilter, tasks.Select(t => t.Assignee ?? "").Distinct().Order().Select(u => (u, u == "" ? "Nessuno" : Name(u))))
        @if (Filtering) { <button class="btn btn-link clear" @onclick="ClearFilters">Azzera</button> }
        <span class="spacer"></span>
        <label class="sort">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4v16M3 16l4 4 4-4M17 20V4M13 8l4-4 4 4" /></svg>
            <select @bind="sort" aria-label="Ordina">
                <option value="updated">Aggiornati di recente</option>
                <option value="created">Creati di recente</option>
                <option value="title">Titolo</option>
            </select>
        </label>
        <div class="seg" role="group" aria-label="Vista">
            <button class="@(board ? "" : "on")" @onclick="() => board = false">☰ Elenco</button>
            <button class="@(board ? "on" : "")" @onclick="() => board = true">▥ Board</button>
        </div>
        <button class="btn btn-primary new" @onclick="OpenNew">+ Nuovo task</button>
    </div>

    @if (error is not null) { <div class="alert alert-danger py-2" role="alert">@error</div> }
    @if (loading) { <p class="text-muted">Caricamento…</p> }
    else if (board)
    {
        <div class="board">
            @foreach (var col in Columns)
            {
                var items = Shown.Where(t => Column(t.Status) == col.Status).ToList();
                var collapsed = collapsedColumns.Contains(col.Status);
                <section class="column @(collapsed ? "collapsed" : "") @(dragOver == col.Status ? "drop" : "")" aria-label="@col.Label"
                         @ondragover="() => dragOver = col.Status" @ondragover:preventDefault @ondragleave="() => dragOver = null" @ondrop="() => DropAsync(col.Status)">
                    <header class="column-head">
                        <span class="sq st-@col.Status" aria-hidden="true"></span>
                        <strong>@col.Label</strong> <span class="n">@items.Count</span>
                        <button class="chev" aria-label="@(collapsed ? "Espandi" : "Comprimi") @col.Label" @onclick="() => Toggle(col.Status)">@(collapsed ? "›" : "⌄")</button>
                    </header>
                    @if (!collapsed)
                    {
                        @if (items.Count == 0) { <div class="empty-col">Nessun task @col.Label.ToLowerInvariant()</div> }
                        @foreach (var t in items)
                        {
                            <article class="card-task" draggable="@(Allowed(t).Count > 1 ? "true" : "false")" @key="t.Id"
                                     @ondragstart="() => dragged = t" @ondragend="() => { dragged = null; dragOver = null; }" @onclick="() => selected = t">
                                <div class="card-ref">@ChannelName(t.ChannelId) #@t.Id</div>
                                <div class="card-title">@t.Title</div>
                                <div class="card-foot" @onclick:stopPropagation>
                                    @StatusPicker(t)
                                    @Person(t.Assignee, t.AssigneeIsAgent)
                                    <span class="ago" title="@t.UpdatedAt.ToLocalTime().ToString("g")">@Ago(t.UpdatedAt)</span>
                                </div>
                            </article>
                        }
                    }
                </section>
            }
        </div>
    }
    else
    {
        <div class="list">
            @if (Shown.Count == 0) { <p class="text-muted p-3 m-0">Nessun task.</p> }
            @foreach (var t in Shown)
            {
                <div class="row-task" @key="t.Id" @onclick="() => selected = t">
                    <span class="sq st-@(t.Status)" aria-hidden="true"></span>
                    <span class="row-id">#@t.Id</span>
                    <span class="row-title">@t.Title</span>
                    <span class="row-channel">@ChannelName(t.ChannelId)</span>
                    <span @onclick:stopPropagation>@StatusPicker(t)</span>
                    @Person(t.Assignee, t.AssigneeIsAgent)
                    <span class="ago">@Ago(t.UpdatedAt)</span>
                </div>
            }
        </div>
    }
</div>

@if (selected is { } s)
{
    <div class="backdrop" @onclick="() => selected = null"></div>
    <aside class="drawer" aria-label="Dettaglio del task">
        <header>
            <span class="card-ref">@ChannelName(s.ChannelId) #@s.Id</span>
            <button class="btn btn-icon" aria-label="Chiudi" @onclick="() => selected = null">✕</button>
        </header>
        <h3>@s.Title</h3>
        <dl>
            <dt>Stato</dt><dd>@StatusPicker(s)</dd>
            <dt>Assegnato a</dt><dd>@Person(s.Assignee, s.AssigneeIsAgent)</dd>
            <dt>Creato da</dt><dd>@Person(s.CreatedBy, false)</dd>
            <dt>Aggiornato</dt><dd>@s.UpdatedAt.ToLocalTime().ToString("g")</dd>
        </dl>
        @if (!string.IsNullOrWhiteSpace(s.Description)) { <h4>Descrizione</h4><p class="pre">@s.Description</p> }
        @if (!string.IsNullOrWhiteSpace(s.Result)) { <h4>@(s.Status == WorkStatus.Failed ? "Errore" : "Risultato")</h4><p class="pre">@s.Result</p> }
        <a class="btn btn-outline-secondary" href="channels/@s.ChannelId">Apri il canale</a>
    </aside>
}

@if (creating)
{
    <div class="backdrop" @onclick="() => creating = false"></div>
    <form class="dialog" @onsubmit="CreateAsync" aria-label="Nuovo task">
        <h3>Nuovo task</h3>
        <label class="form-label" for="nt-channel">Canale</label>
        <select id="nt-channel" class="form-select" value="@newChannel" @onchange="ChannelChangedAsync">
            @foreach (var c in channels.Where(c => c.With is null)) { <option value="@c.Id">#@c.Name</option> }
        </select>
        <label class="form-label" for="nt-title">Titolo</label>
        <input id="nt-title" class="form-control" maxlength="200" @bind="newTitle" @bind:event="oninput" placeholder="Cosa c'è da fare?" />
        <label class="form-label" for="nt-desc">Descrizione</label>
        <textarea id="nt-desc" class="form-control" rows="4" maxlength="4000" @bind="newDescription" placeholder="Dettagli (facoltativi)"></textarea>
        <label class="form-label" for="nt-who">Assegna a</label>
        <select id="nt-who" class="form-select" @bind="newAssignee">
            <option value="">Nessuno</option>
            <option value="@NewTaskRequest.Me">A me</option>
            @foreach (var a in newAgents) { <option value="@a">@a · agente (inizia subito)</option> }
        </select>
        <div class="dialog-actions">
            <button type="button" class="btn btn-outline-secondary" @onclick="() => creating = false">Annulla</button>
            <button class="btn btn-primary" type="submit" disabled="@(string.IsNullOrWhiteSpace(newTitle) || newChannel == 0)">Crea task</button>
        </div>
    </form>
}

@code {
    sealed record Col(WorkStatus Status, string Label);
    static readonly Col[] Columns =
    [
        new(WorkStatus.Backlog, "Backlog"), new(WorkStatus.Todo, "Da fare"), new(WorkStatus.InProgress, "In corso"),
        new(WorkStatus.Done, "Fatto"), new(WorkStatus.Closed, "Chiuso"),
    ];
    static WorkStatus Column(WorkStatus s) => s == WorkStatus.Failed ? WorkStatus.Closed : s; // i falliti stanno tra i chiusi, in rosso
    static string Label(WorkStatus s) => s == WorkStatus.Failed ? "Fallito" : Columns.First(c => c.Status == s).Label;

    List<TaskDto> tasks = [];
    List<ChannelDto> channels = [];
    Dictionary<string, string> agentIcons = new(StringComparer.OrdinalIgnoreCase);
    string me = "";
    bool mine = true, board = true, loading = true, creating;
    string query = "", sort = "updated";
    string? error;
    readonly HashSet<string> channelFilter = [], statusFilter = [], creatorFilter = [], assigneeFilter = [];
    readonly HashSet<WorkStatus> collapsedColumns = [];
    TaskDto? selected, dragged;
    WorkStatus? dragOver;
    int newChannel;
    string newTitle = "", newDescription = "", newAssignee = "";
    List<string> newAgents = [];
    readonly CancellationTokenSource stop = new();

    bool IsMine(TaskDto t) => t.CreatedBy == me || t.Assignee == me;
    IEnumerable<TaskDto> Scoped => mine ? tasks.Where(IsMine) : tasks;
    bool Filtering => channelFilter.Count + statusFilter.Count + creatorFilter.Count + assigneeFilter.Count > 0 || query.Length > 0;

    List<TaskDto> Shown
    {
        get
        {
            var q = query.Trim();
            var list = Scoped.Where(t =>
                (channelFilter.Count == 0 || channelFilter.Contains(t.ChannelId.ToString()))
                && (statusFilter.Count == 0 || statusFilter.Contains(t.Status.ToString()))
                && (creatorFilter.Count == 0 || creatorFilter.Contains(t.CreatedBy))
                && (assigneeFilter.Count == 0 || assigneeFilter.Contains(t.Assignee ?? ""))
                && (q.Length == 0 || t.Title.Contains(q, StringComparison.OrdinalIgnoreCase) || t.Description.Contains(q, StringComparison.OrdinalIgnoreCase) || $"#{t.Id}" == q));
            return (sort switch
            {
                "created" => list.OrderByDescending(t => t.Id),
                "title" => list.OrderBy(t => t.Title, StringComparer.CurrentCultureIgnoreCase),
                _ => list.OrderByDescending(t => t.UpdatedAt),
            }).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        loading = false;
        if (!OperatingSystem.IsBrowser() && !OperatingSystem.IsIOS() && !OperatingSystem.IsAndroid()) return; // prerender: niente timer né icone
        try { agentIcons = (await Ws.GetAgentIconsAsync()).ToDictionary(i => i.Key, i => "data:image/svg+xml;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(i.Value)), StringComparer.OrdinalIgnoreCase); }
        catch (Exception) { } // senza icone restano i simboli
        _ = RefreshLoopAsync();
    }

    // shortcut: gli eventi "task" arrivano solo per il canale osservato, quindi qui si rilegge ogni 10 s.
    async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try
        {
            while (await timer.WaitForNextTickAsync(stop.Token))
            {
                if (dragged is not null || creating) continue;
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    async Task LoadAsync()
    {
        try
        {
            me = me.Length > 0 ? me : await Ws.WhoAmIAsync();
            channels = await Ws.GetChannelsAsync();
            tasks = await Ws.GetAllTasksAsync();
            if (selected is { } s) selected = tasks.FirstOrDefault(t => t.Id == s.Id);
            error = null;
        }
        catch (Exception ex) { error = ex.GetBaseException().Message; }
    }

    // Stati in cui l'utente può spostare il task: gli agenti gestiscono da soli "In corso" e "Fatto".
    static List<WorkStatus> Allowed(TaskDto t)
    {
        if (t.AssigneeIsAgent && t.Status == WorkStatus.InProgress) return [t.Status];
        List<WorkStatus> all = t.AssigneeIsAgent ? [WorkStatus.Backlog, WorkStatus.Todo, WorkStatus.Closed]
            : [WorkStatus.Backlog, WorkStatus.Todo, WorkStatus.InProgress, WorkStatus.Done, WorkStatus.Closed];
        if (!all.Contains(t.Status)) all.Insert(0, t.Status);
        return all;
    }

    async Task SetStatusAsync(TaskDto t, WorkStatus status)
    {
        if (status == t.Status) return;
        var i = tasks.FindIndex(x => x.Id == t.Id);
        if (i >= 0) tasks[i] = t with { Status = status, UpdatedAt = DateTimeOffset.UtcNow }; // subito sulla board, poi conferma del server
        try { await Ws.SetTaskStatusAsync(t.Id, status); error = null; }
        catch (Exception ex) { error = ex.GetBaseException().Message; }
        await LoadAsync();
    }

    async Task DropAsync(WorkStatus column)
    {
        dragOver = null;
        if (dragged is not { } t) return;
        dragged = null;
        if (Column(t.Status) == column) return;
        if (!Allowed(t).Contains(column)) { error = t.AssigneeIsAgent ? "I task degli agenti si spostano solo in Backlog, Da fare o Chiuso, e non mentre ci lavorano." : "Spostamento non consentito."; return; }
        await SetStatusAsync(t, column);
    }

    void Toggle(WorkStatus s) { if (!collapsedColumns.Remove(s)) collapsedColumns.Add(s); }

    void ClearFilters() { channelFilter.Clear(); statusFilter.Clear(); creatorFilter.Clear(); assigneeFilter.Clear(); query = ""; }

    async Task OpenNew()
    {
        creating = true; newTitle = newDescription = newAssignee = "";
        newChannel = channelFilter.Count == 1 && int.TryParse(channelFilter.First(), out var c) ? c : channels.FirstOrDefault(x => x.With is null)?.Id ?? 0;
        await LoadAgentsAsync();
    }

    async Task ChannelChangedAsync(ChangeEventArgs e)
    {
        newChannel = int.TryParse(e.Value as string, out var c) ? c : 0;
        newAssignee = "";
        await LoadAgentsAsync();
    }

    async Task LoadAgentsAsync()
    {
        try { newAgents = newChannel == 0 ? [] : (await Ws.GetChannelAgentsAsync(newChannel)).Agents; }
        catch (Exception) { newAgents = []; }
    }

    async Task CreateAsync()
    {
        try
        {
            var t = await Ws.CreateTaskAsync(newChannel, new NewTaskRequest(newTitle.Trim(), newDescription.Trim(), newAssignee.Length == 0 ? null : newAssignee));
            creating = false; error = null;
            tasks.Insert(0, t);
            await LoadAsync();
        }
        catch (Exception ex) { error = ex.GetBaseException().Message; creating = false; }
    }

    string ChannelName(int id) => channels.FirstOrDefault(c => c.Id == id) is { } c ? c.With is { } w ? $"@{Name(w)}" : $"#{c.Name}" : $"#{id}";
    static string Name(string user) => user.Split('@')[0];

    static string Ago(DateTimeOffset t)
    {
        var d = DateTimeOffset.UtcNow - t;
        return d.TotalMinutes < 1 ? "ora" : d.TotalHours < 1 ? $"{d.TotalMinutes:0} min fa" : d.TotalDays < 1 ? $"{d.TotalHours:0} h fa" : $"{d.TotalDays:0} g fa";
    }

    static string Initials(string user)
    {
        var parts = Name(user).Split(['.', '_', '-', ' '], StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}" : Name(user)[..Math.Min(2, Name(user).Length)];
    }

    RenderFragment StatusPicker(TaskDto t) =>
        @<label class="status-pick @(t.Status == WorkStatus.Failed ? "failed" : "")">
            <span class="sq st-@t.Status" aria-hidden="true"></span>
            <select value="@t.Status" disabled="@(Allowed(t).Count < 2)" aria-label="Stato del task #@t.Id"
                    @onchange="e => SetStatusAsync(t, Enum.Parse<WorkStatus>((string)e.Value!))">
                @foreach (var s in Allowed(t)) { <option value="@s">@Label(s)</option> }
            </select>
        </label>;

    RenderFragment Person(string? user, bool agent) =>
        @<span class="person">@if (user is null)
        {
            <span class="text-muted">Nessuno</span>
        }
        else
        {
            @if (agent && agentIcons.TryGetValue(user, out var src)) { <span class="avatar avatar-agent avatar-icon" style="--size: 1.4rem"><img src="@src" alt="" /></span> }
            else if (agent) { <span class="avatar avatar-agent" style="--size: 1.4rem">✦</span> }
            else { <span class="avatar" style="@AvatarColor.Style(user, "1.4rem")">@Initials(user)</span> }
            <span>@Name(user)</span>
        }</span>;

    // Menu a tendina con caselle: <details> si apre e chiude senza JavaScript.
    RenderFragment Filter(string label, string icon, HashSet<string> chosen, IEnumerable<(string Value, string Text)> options) =>
        @<details class="dd @(chosen.Count > 0 ? "active" : "")">
            <summary><span class="dd-icon" aria-hidden="true">@icon</span>@label @if (chosen.Count > 0) { <span class="dd-n">@chosen.Count</span> }<span class="dd-chev" aria-hidden="true">⌄</span></summary>
            <div class="dd-menu">
                @foreach (var (value, text) in options)
                {
                    <label class="dd-option">
                        <input type="checkbox" checked="@chosen.Contains(value)" @onchange="e => { if (e.Value is true) chosen.Add(value); else chosen.Remove(value); }" />
                        @text
                    </label>
                }
            </div>
        </details>;

    public void Dispose() { stop.Cancel(); stop.Dispose(); }
}
