@* Notifiche di una conversazione (canale o messaggio diretto): vince sulle impostazioni dell'account. *@
@inject IWorkspaceClient Ws

<select class="form-select form-select-sm w-auto" aria-label="Notifiche di questa conversazione" title="@error"
        value="@level" disabled="@(level is null)" @onchange="ChangeAsync">
    <option value="@NotifyLevels.Default">🔔 Predefinite</option>
    <option value="@NotifyLevels.All">🔔 Tutti i messaggi</option>
    <option value="@NotifyLevels.Mentions">🔔 Solo menzioni</option>
    <option value="@NotifyLevels.Mute">🔕 Silenziata</option>
</select>

@code {
    [Parameter, EditorRequired] public int ChannelId { get; set; }
    string? level, error;
    int loaded;

    protected override async Task OnParametersSetAsync()
    {
        if (loaded == ChannelId) return;
        (loaded, level, error) = (ChannelId, null, null);
        try { level = (await Ws.GetChannelNotifyAsync(ChannelId)).Level; }
        catch (Exception ex) { error = ex.GetBaseException().Message; }
    }

    async Task ChangeAsync(ChangeEventArgs e)
    {
        var previous = level;
        level = e.Value as string ?? NotifyLevels.Default;
        try { await Ws.SetChannelNotifyAsync(ChannelId, level); error = null; }
        catch (Exception ex) { level = previous; error = ex.GetBaseException().Message; }
    }
}
