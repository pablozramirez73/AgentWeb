@page "/devices"
@rendermode InteractiveWebAssembly
@inject IAccountClient Account

<PageTitle>@T("settings.devices") · AgentWeb</PageTitle>

<SettingsShell Title="@T("settings.devices")">
<div class="page-header">
    <p>@T("devices.intro")</p>
</div>

@if (error is not null)
{
    <div class="alert alert-danger py-2" role="alert">@error</div>
}
@if (Sessions is null)
{
    <p class="text-muted">@T("common.loading")</p>
}
else
{
    <ul class="sessions">
        @foreach (var s in Sessions)
        {
            <li class="session fade-in" @key="s.Id">
                <span class="session-icon" aria-hidden="true">
                    @if (s.Kind == "web") { <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8M12 17v4" /></svg> }
                    else if (s.Kind == "token") { <svg viewBox="0 0 24 24"><circle cx="8" cy="15" r="4" /><path d="m10.8 12.2 8.2-8.2M16 7l3 3M14 9l2 2" /></svg> }
                    else { <svg viewBox="0 0 24 24"><rect x="7" y="2.5" width="10" height="19" rx="2.5" /><path d="M11 18.5h2" /></svg> }
                </span>
                <div class="session-body">
                    <div class="session-title">@Title(s) @if (s.Current) { <span class="badge bg-success ms-1">@T("devices.thisOne")</span> }</div>
                    <div class="session-meta">@Kind(s.Kind) · @T("devices.since", Since(s.CreatedAt.ToLocalTime()))</div>
                </div>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => RevokeAsync(s)">@T(s.Current ? "nav.signOut" : "devices.revoke")</button>
            </li>
        }
    </ul>
    <button class="btn btn-outline-danger btn-sm mt-2" @onclick="RevokeAllAsync">@T("devices.signOutAll")</button>
}

<h4 class="mt-4">@T("2fa.title")</h4>
@if (twoFactor is null) { <p class="text-muted">@T("common.loading")</p> }
else if (twoFactor.Enabled)
{
    <p>@T("2fa.onText")</p>
    <form @onsubmit="DisableTwoFactorAsync" class="d-flex gap-2 mb-2" style="max-width: 360px">
        <input class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="8" @bind="twoFactorCode" @bind:event="oninput" placeholder="@T("2fa.currentCode")" aria-label="@T("2fa.codeToDisable")" />
        <button class="btn btn-outline-danger" type="submit" disabled="@(twoFactorCode.Length == 0)">@T("common.disable")</button>
    </form>
}
else
{
    <p class="text-muted">@T("2fa.setupText")</p>
    <p><code class="user-select-all">@twoFactor.SharedKey</code></p>
    <details class="mb-2"><summary class="small">@T("2fa.otpLink")</summary><code class="user-select-all small">@twoFactor.AuthenticatorUri</code></details>
    <form @onsubmit="EnableTwoFactorAsync" class="d-flex gap-2 mb-2" style="max-width: 360px">
        <input class="form-control" inputmode="numeric" autocomplete="one-time-code" maxlength="8" @bind="twoFactorCode" @bind:event="oninput" placeholder="@T("2fa.sixDigits")" aria-label="@T("login.code")" />
        <button class="btn btn-primary" type="submit" disabled="@(twoFactorCode.Length == 0)">@T("common.enable")</button>
    </form>
}
@if (twoFactorMessage is { } tm) { <div class="@(tm.Ok ? "text-success" : "text-danger") mb-2" role="status">@tm.Text</div> }

<h4 class="mt-4">@T("tokens.title")</h4>
<p class="text-muted">@((MarkupString)T("tokens.intro", $"<code>{System.Net.WebUtility.HtmlEncode(Mcp)}</code>"))</p>
<form @onsubmit="CreateTokenAsync" class="d-flex gap-2 mb-3">
    <input class="form-control" style="max-width: 320px" @bind="tokenName" @bind:event="oninput" placeholder="@T("tokens.placeholder")" aria-label="@T("tokens.name")" maxlength="100" />
    <button class="btn btn-primary" type="submit" disabled="@string.IsNullOrWhiteSpace(tokenName)">@T("tokens.create")</button>
</form>
@if (created is { } t)
{
    <div class="alert alert-warning">
        <strong>@T("tokens.copyNow", t.Name)</strong>
        <pre class="mt-2 mb-3 user-select-all" style="white-space: pre-wrap; word-break: break-all">@t.Token</pre>
        <div class="small">
            <strong>Claude Code</strong> (@T("tokens.terminal")):
            <pre class="user-select-all" style="white-space: pre-wrap; word-break: break-all">claude mcp add --transport http agentweb @Mcp --header "Authorization: Bearer @t.Token"</pre>
            <strong>Hermes</strong> (<code>~/.hermes/config.yaml</code>, @T("tokens.under") <code>mcp_servers:</code>), @T("tokens.then") <code>hermes mcp test agentweb</code>:
            <pre class="user-select-all">  agentweb:
    url: @Mcp
    headers:
      Authorization: Bearer @t.Token</pre>
            <strong>@T("tokens.otherClients")</strong>: @T("tokens.transport") <code>@Mcp</code> @T("tokens.withHeader") <code>Authorization: Bearer &lt;token&gt;</code>.
        </div>
    </div>
}
</SettingsShell>

@code {
    // Mese dai file di lingua, non dalla cultura del browser: il testo intorno è nella lingua dell'installazione.
    static string Since(DateTimeOffset d) => $"{d.Day} {T("stats.months").Split(',')[d.Month - 1]} {d.Year}, {d:HH:mm}";
    // Persistito dal prerender: il browser non richiede di nuovo l'elenco appena caricato sul server.
    [PersistentState] public List<SessionDto>? Sessions { get; set; }
    string? error;
    string tokenName = "";
    ApiTokenDto? created;

    string Mcp => new Uri(Account.ServerBase, "mcp").ToString();


    TwoFactorDto? twoFactor;
    string twoFactorCode = "";
    (bool Ok, string Text)? twoFactorMessage;

    Task EnableTwoFactorAsync() => ChangeTwoFactorAsync(() => Account.EnableTwoFactorAsync(twoFactorCode.Trim()), T("2fa.enabled"));
    Task DisableTwoFactorAsync() => ChangeTwoFactorAsync(() => Account.DisableTwoFactorAsync(twoFactorCode.Trim()), T("2fa.disabled"));

    async Task ChangeTwoFactorAsync(Func<Task> change, string done)
    {
        try { await change(); twoFactorMessage = (true, done); twoFactorCode = ""; twoFactor = await Account.GetTwoFactorAsync(); }
        catch (Exception ex) { twoFactorMessage = (false, ex.GetBaseException().Message); }
    }
    async Task CreateTokenAsync()
    {
        try { created = await Account.CreateTokenAsync(tokenName.Trim()); tokenName = ""; }
        catch (Exception ex) { error = ex.GetBaseException().Message; return; }
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        if (Sessions is null) await LoadAsync();
        try { twoFactor ??= await Account.GetTwoFactorAsync(); }
        catch (Exception ex) { twoFactorMessage = (false, ex.GetBaseException().Message); }
    }

    async Task LoadAsync()
    {
        try { Sessions = await Account.GetSessionsAsync(); error = null; }
        catch (Exception ex) { error = ex.GetBaseException().Message; }
    }

    // La sessione corrente revocata: la prossima chiamata riceve 401 e web/app tornano al login da soli.
    async Task RevokeAsync(SessionDto s)
    {
        try { await Account.RevokeSessionAsync(s.Id); }
        catch (Exception ex) { error = ex.GetBaseException().Message; return; }
        await LoadAsync();
    }

    async Task RevokeAllAsync()
    {
        try { await Account.RevokeAllSessionsAsync(); }
        catch (Exception ex) { error = ex.GetBaseException().Message; return; }
        await LoadAsync();
    }

    static string Kind(string k) => k switch { "web" => "Browser", "app" => T("devices.kind.app"), "token" => T("devices.kind.token"), _ => k };

    // Nome leggibile dallo User-Agent salvato con la sessione (o il nome dato al token).
    static string Title(SessionDto s)
    {
        var d = s.Device ?? "";
        if (s.Kind == "token") return d.Length > 0 ? d : "Token";
        if (d.StartsWith("AgentWeb-App/")) return "App AgentWeb " + (d.Contains("iOS") ? "· iPhone" : d.Contains("Android") ? "· Android" : "");
        if (d.StartsWith("agentweb-cli/")) return T("devices.cli");
        var browser = d.Contains("Edg/") ? "Edge" : d.Contains("Chrome/") ? "Chrome" : d.Contains("Firefox/") ? "Firefox" : d.Contains("Safari/") ? "Safari" : "Browser";
        var os = d.Contains("Mac OS X") ? "macOS" : d.Contains("Windows") ? "Windows" : d.Contains("iPhone") ? "iPhone" : d.Contains("Android") ? "Android" : d.Contains("Linux") ? "Linux" : "";
        return os.Length > 0 ? T("devices.browserOn", browser, os) : browser;
    }
}
