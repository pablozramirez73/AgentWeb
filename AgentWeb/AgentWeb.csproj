<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <MauiVersion>11.0.10</MauiVersion>
    <!-- shortcut: CoreCLR al posto di Mono solo con -p:CoreClr=true, finché non è misurato sul dispositivo -->
    <UseMonoRuntime Condition="'$(CoreClr)' == 'true'">false</UseMonoRuntime>
    <TargetFrameworks>net11.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net11.0-ios</TargetFrameworks>


    <OutputType>Exe</OutputType>
    <RootNamespace>AgentWeb</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Disable MAUI CSS handling so Blazor can handle it -->
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>AgentWeb</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.companyname.agentweb</ApplicationId>
    <!-- iOS: ID registrato nel team personale Apple (profilo "iOS Team Provisioning Profile: com.lucaguelfi.agentweb") -->
    <ApplicationId Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">com.lucaguelfi.agentweb</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>


    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <!-- Il bundle .icon lo compila actool: i suoi file non vanno copiati nell'app come contenuto (iOS rifiuta la cartella Resources). -->
    <Content Remove="Resources\AppIcon\AppIcon.icon\**" />
    <!-- iOS/Mac: icona Liquid Glass di Icon Composer (livelli in vetro); Android: lo stesso disegno in SVG. -->
    <MauiIcon Include="Resources\AppIcon\AppIcon.icon" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" />
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2A1C7A" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'maccatalyst'" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AGUI.Client" Version="1.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="11.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentWeb.Shared\AgentWeb.Shared.csproj" />
  </ItemGroup>

  <!-- Indirizzo del server AgentWeb compilato nell'app: dotnet build -p:AgentWebServer=http://macbook.local:5294/ -->
  <PropertyGroup>
    <AgentWebServer Condition="'$(AgentWebServer)' == ''">http://localhost:5294/</AgentWebServer>
  </PropertyGroup>
  <!-- Notifiche APNs: servono un account Apple Developer a pagamento e un profilo con Push Notifications. dotnet build -p:ApnsPush=true -->
  <PropertyGroup Condition="'$(ApnsPush)' == 'true' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <CodesignEntitlements>Platforms/iOS/Entitlements.Push.plist</CodesignEntitlements>
    <DefineConstants>$(DefineConstants);APNS_PUSH</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="AgentWebServer" Value="$(AgentWebServer)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0-android'">
    <PackageReference Include="Pushy.SDK.MAUI.Android" Version="1.0.127" />
  </ItemGroup>

</Project>
