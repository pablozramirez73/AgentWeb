<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgentWeb.Shared\AgentWeb.Shared.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>agentweb</AssemblyName>
    <RootNamespace>AgentWeb.Cli</RootNamespace>
    <!-- "dotnet pack" crea uno strumento .NET installabile (dotnet tool install, sorgente ./nupkg) -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agentweb</ToolCommandName>
    <PackageId>AgentWeb.Cli</PackageId>
    <Version>0.6.0</Version>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

</Project>
